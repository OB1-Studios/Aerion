# Copy to .env for local development; in production these go into Coolify's environment settings.
# `pnpm infra:apply` writes the Vultr values (database, storage, inference) to .env.vultr.

# Database: local embedded Postgres (`pnpm dev:db`) or Vultr Managed PostgreSQL (?sslmode=require)
DATABASE_URL=postgres://ebo:ebo@localhost:54329/ebo
# Optional: the managed database's CA certificate (PEM, \n for line breaks) to verify the server
DATABASE_CA_CERT=

# Sign-in (better-auth)
BETTER_AUTH_SECRET=change-me-to-32-random-bytes-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
# Seals stored secrets such as mailbox app passwords, and the database backups (openssl rand -hex 32).
# Locally it can stay empty: BETTER_AUTH_SECRET is used instead. Changing it means reconnecting
# mailboxes, and older backups can only be opened with the old key, so keep a copy off the server.
APP_ENCRYPTION_KEY=

# Document storage: Vultr Object Storage (S3-compatible). Leave empty to use ./.storage locally.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=
# Nightly database backups (pnpm backup, backup:list, backup:restore). Empty = ./.backups locally.
S3_BUCKET_BACKUPS=
BACKUP_KEEP=14

# Reading documents with Vultr Serverless Inference. Empty = built-in layout rules only.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
VULTR_INFERENCE_CLASSIFY_MODEL=
VULTR_INFERENCE_JSON_MODE=object

# Optional: live platform status on the settings page (Vultr API key, ideally IP-restricted)
VULTR_API_KEY=
VULTR_INSTANCE_ID=
VULTR_DATABASE_ID=
VULTR_OBJECT_STORAGE_ID=
VULTR_INFERENCE_ID=

# Demo: password for the shared demo accounts (`pnpm seed`)
DEMO_PASSWORD=
# Local development: the web process runs a queued run itself straight away. Safe alongside the
# worker (whichever claims the run first runs it); leave it out in production.
RUNS_INLINE=1
