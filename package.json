{
  "name": "it-export-back-office",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ebo/web dev",
    "dev:all": "pnpm --parallel --filter @ebo/web --filter @ebo/worker dev",
    "local": "node scripts/local.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "db:generate": "pnpm --filter @ebo/db generate",
    "db:migrate": "pnpm --filter @ebo/db migrate",
    "seed": "pnpm --filter @ebo/db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --no-bail typecheck",
    "build": "pnpm --filter @ebo/web build",
    "vultr:types": "pnpm --filter @ebo/vultr generate",
    "infra:plan": "pnpm --filter @ebo/infra plan",
    "infra:apply": "pnpm --filter @ebo/infra apply",
    "infra:status": "pnpm --filter @ebo/infra status"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
